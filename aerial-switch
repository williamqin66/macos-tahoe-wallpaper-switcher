class Style:
    """Output capabilities: colour, Unicode glyphs and Chinese text."""

    def __init__(self, color=False, ascii=False, english=False, palette=8):
        self.color, self.ascii, self.english, self.palette = color, ascii, english, palette
        self.glyphs = GLYPHS["ascii" if ascii else "unicode"]
        self.lw = 11 if english else 7  # label column: "下一张 " is 7 columns

    @classmethod
    def for_encoding(cls, encoding, tty=True, environ=None):
        import codecs
        environ = os.environ if environ is None else environ
        try:
            utf8 = codecs.lookup(encoding or "ascii").name == "utf-8"
        except LookupError:
            utf8 = False
        try:
            "早晨傍晚现在".encode(encoding or "ascii")
            chinese = True
        except (LookupError, UnicodeError):
            chinese = False
        term = environ.get("TERM", "")
        color = bool(tty and not environ.get("NO_COLOR") and term != "dumb")
        palette = 256 if "256color" in term or environ.get("COLORTERM") else 8
        return cls(color=color, ascii=not utf8, english=not chinese, palette=palette)

    @classmethod
    def for_stream(cls, stream, environ=None):
        try:
            tty = stream.isatty()
        except (AttributeError, ValueError):
            tty = False
        return cls.for_encoding(getattr(stream, "encoding", None), tty, environ)

    def g(self, name):
        return self.glyphs[name]

    def bar(self, period):
        return self.glyphs["bar"][period]

    def t(self, text, **values):
        if self.english:
            text = EN.get(text, text)
        return text.format(**values) if values else text

    def join(self, items):
        return (", " if self.english else "、").join(items)

    def ansi(self, name):
        codes = []
        attr = ATTRS.get(name)
        color = COLORS.get(name)
        if color and self.palette == 256 and color[0] is not None:
            codes.append(f"38;5;{color[0]}")
            if attr == "dim":
                attr = None
        elif color and color[1] is not None:
            codes.append(f"3{color[1]}")
        if attr:
            codes.insert(0, ANSI_ATTRS[attr])
        return ";".join(codes)


def char_width(ch):
    if unicodedata.combining(ch) or ch in "​‍":
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def dwidth(text):
    return sum(char_width(ch) for ch in text)


def clip(text, width, ellipsis=""):
    if dwidth(text) <= width:
        return text
    limit = width - dwidth(ellipsis)
    if limit < 0:
        return clip(ellipsis, width)
    out, used = [], 0
    for ch in text:
        size = char_width(ch)
        if used + size > limit:
            break
        out.append(ch)
        used += size
    return "".join(out) + ellipsis


def pad(text, width):
    return text + " " * max(0, width - dwidth(text))


def line_width(line):
    return sum(dwidth(text) for text, _ in line)


def plain(line):
    return "".join(text for text, _ in line)


def clip_line(line, width, ellipsis="…"):
    if line_width(line) <= width:
        return line
    limit = max(0, width - dwidth(ellipsis))
    out, used = [], 0
    for text, style in line:
        size = dwidth(text)
        if used + size <= limit:
            out.append((text, style))
            used += size
            continue
        out.append((clip(text, limit - used), style))
        break
    out.append((clip(ellipsis, width), "dim"))
    return out


_CJK = "⺀-鿿　-〿＀-￯"
_WRAP_TOKEN = re.compile(rf"\s+|[{_CJK}]|[^\s{_CJK}]+")


def wrap_text(text, width):
    """Wrap by display width; CJK may break between characters, words at spaces."""
    width = max(1, width)
    lines, current = [], ""
    for token in _WRAP_TOKEN.findall(text):
        if token.isspace():
            if current:
                current += " "
            continue
        if dwidth(current + token) <= width:
            current += token
            continue
        if current.strip():
            lines.append(current.rstrip())
        current = ""
        while dwidth(token) > width:
            head = clip(token, width)
            lines.append(head)
            token = token[len(head):]
        current = token
    if current.strip() or not lines:
        lines.append(current.rstrip())
    return lines


def flow(prefix, chunks, width, indent, sep="  ", ellipsis="…"):
    """Lay chunks on a line after prefix, wrapping to indent when too wide."""
    lines, current = [], list(prefix)
    used, fresh = line_width(current), True
    for chunk in chunks:
        size = line_width(chunk)
        gap = 0 if fresh else dwidth(sep)
        if not fresh and used + gap + size > width:
            lines.append(current)
            current, used, fresh, gap = [(" " * indent, "")], indent, True, 0
            if chunk and chunk[0][0][:1] == " ":  # no stray space at a wrapped line start
                chunk = [(chunk[0][0].lstrip(), chunk[0][1])] + list(chunk[1:])
                size = line_width(chunk)
        if gap:
            current.append((sep, ""))
            used += gap
        current.extend(chunk)
        used += size
        fresh = False
    lines.append(current)
    return [clip_line(line, width, ellipsis) for line in lines]


def label_prefix(st, label, style="label"):
    return [(" " * INDENT, ""), (pad(st.t(label), st.lw), style)]


def text_rows(st, label, text, width, style="", label_style="label"):
    column = INDENT + st.lw
    rows = []
    for index, part in enumerate(wrap_text(text, max(8, width - column))):
        head = label_prefix(st, label, label_style) if index == 0 else [(" " * column, "")]
        rows.append(clip_line(head + [(part, style)], width, st.g("ellipsis")))
    return rows


def info_row(st, label, main, tail, width):
    head = label_prefix(st, label) + main
    ellipsis = st.g("ellipsis")
    if not tail:
        return [clip_line(head, width, ellipsis)]
    if line_width(head) + 3 + line_width(tail) <= width:
        return [head + [("   ", "")] + tail]
    return [clip_line(head, width, ellipsis),
            clip_line([(" " * (INDENT + st.lw), "")] + tail, width, ellipsis)]


def hhmm(minute):
    return f"{minute // 60:02d}:{minute % 60:02d}"


def human_bytes(size):
    size = size or 0
    for unit, scale in (("GB", 1024 ** 3), ("MB", 1024 ** 2), ("KB", 1024)):
        if size >= scale:
            return f"{size / scale:.1f} {unit}"
    return f"{size} B"


def hours_text(value):
    return f"{value:g}"


def coords_text(st, cfg):
    deg = st.g("deg")
    lat, lon = cfg["lat"], cfg["lon"]
    text = (f"{abs(lat):.4f}{deg}{'N' if lat >= 0 else 'S'} "
            f"{abs(lon):.4f}{deg}{'E' if lon >= 0 else 'W'}")
    return f"{cfg['city']} {st.g('dot')} {text}" if cfg.get("city") else text


def durations_text(st, cfg):
    return st.t("早晨 {m} 小时 · 傍晚自日落前 {b} 至日落后 {a} 小时",
                m=hours_text(cfg["morningHoursAfterSunrise"]),
                b=hours_text(cfg["eveningHoursBeforeSunset"]),
                a=hours_text(cfg["eveningHoursAfterSunset"]))


def parse_when(value):
    try:
        return dt.datetime.fromisoformat(value)
    except (TypeError, ValueError):
        return None


def when_text(st, when, now):
    days = (when.date() - now.date()).days
    base = when.strftime("%H:%M")
    if days == 0:
        return base
    if days == 1:
        return st.t("明天") + " " + base
    return st.t("{m}月{d}日", m=when.month, d=when.day) + " " + base


def countdown_text(st, seconds, precise=False):
    if seconds <= 0:
        return st.t("即将切换")
    if precise:
        total = int(seconds)
        if total < 3600:
            return st.t("{m} 分 {s:02d} 秒后", m=total // 60, s=total % 60)
        if total < 86400:
            return st.t("{h} 小时 {m:02d} 分后", h=total // 3600, m=total % 3600 // 60)
        return st.t("{d} 天 {h} 小时后", d=total // 86400, h=total % 86400 // 3600)
    minutes = math.ceil(seconds / 60)
    if minutes < 60:
        return st.t("约 {m} 分钟后", m=minutes)
    if minutes < 1440:
        hours, rest = divmod(minutes, 60)
        return st.t("约 {h} 小时后", h=hours) if not rest else st.t("约 {h} 小时 {m} 分钟后", h=hours, m=rest)
    return st.t("约 {d} 天后", d=round(minutes / 1440))


def day_schedule(now, cfg):
    """Classify every minute of today's local date exactly as apply would."""
    rise, setting, cos_ha = solar(now, cfg["lat"], cfg["lon"])
    minutes = [period_at(minute / 60, rise, setting, cos_ha, cfg) for minute in range(1440)]
    starts = [(minutes[m], m) for m in range(1440) if minutes[m] != minutes[m - 1]]
    first = next((i for i, (period, _) in enumerate(starts) if period == "morning"), 0)
    condition = "polar night" if cos_ha >= 1 else "polar day" if cos_ha <= -1 else "normal"
    return {"condition": condition, "minutes": minutes, "starts": starts[first:] + starts[:first]}


def bar_width_for(width, maximum=48):
    return max(8, min(maximum, width - INDENT - 1))


def bar_cells(schedule, bar_width):
    return [schedule["minutes"][min(1439, int((column + 0.5) * 1440 / bar_width))]
            for column in range(bar_width)]


def marker_column(now, bar_width):
    return min(bar_width - 1, (now.hour * 60 + now.minute) * bar_width // 1440)


def timeline_lines(st, schedule, now, width, bar_width):
    ellipsis = st.g("ellipsis")
    if schedule["starts"]:
        chunks = [[(hhmm(minute) + " ", "dim"), (st.t(PERIOD_NAMES[period]), period)]
                  for period, minute in schedule["starts"]]
    else:
        period = schedule["minutes"][0]
        name, note = (("极昼", " · 全天白天") if period == "day" else ("极夜", " · 全天夜晚"))
        chunks = [[(st.t(name), period), (st.t(note), "dim")]]
    lines = flow([(" " * INDENT, "")], chunks, width, INDENT, sep="   ", ellipsis=ellipsis)
    bar = [(" " * INDENT, "")]
    for period in bar_cells(schedule, bar_width):
        if bar[-1][1] == period:
            bar[-1] = (bar[-1][0] + st.bar(period), period)
        else:
            bar.append((st.bar(period), period))
    lines.append(clip_line(bar, width, ellipsis))
    column = INDENT + marker_column(now, bar_width)
    label = st.t("现在") + " " + now.strftime("%H:%M")
    if column + 2 + dwidth(label) <= width:
        marker = [(" " * column, ""), (st.g("marker"), "marker"), (" " + label, "dim")]
    else:
        text = label + " "
        start = max(0, column - dwidth(text))
        marker = [(" " * start, ""), (clip(text, column - start), "dim"), (st.g("marker"), "marker")]
    lines.append(clip_line(marker, width, ellipsis))
    return lines


VIDEO_STATES = ("protected", "unprotected", "restorable", "downloading", "missing")
STATE_GLYPH = {
    "protected": ("ok", "ok"), "unprotected": ("unpinned", "warn"),
    "restorable": ("restorable", "dim"), "downloading": ("downloading", "accent"),
    "missing": ("missing", "warn"), "absent": ("fail", "err"),
}
STATE_TEXT = {
    "unprotected": "未保护", "restorable": "可从保护恢复", "downloading": "下载中",
    "missing": "缺失，应用时下载", "absent": "素材清单中缺失",
}


def video_state(video):
    if video.get("present") and video.get("pinned") and video.get("sameInode"):
        return "protected"
    if video.get("present"):
        return "unprotected"
    return "restorable" if video.get("pinned") else "missing"


def video_states(snap):
    states = {}
    videos = (snap or {}).get("videos") or {}
    for period in PERIODS:
        video = videos.get(period)
        if isinstance(video, dict):
            states[period] = video_state(video)
    if snap and snap.get("downloadInProgress"):
        # One download runs at a time: the current period first, then later ones.
        start = PERIODS.index(snap["period"]) if snap.get("period") in PERIODS else 0
        for offset in range(len(PERIODS)):
            period = PERIODS[(start + offset) % len(PERIODS)]
            if states.get(period) == "missing":
                states[period] = "downloading"
                break
    return states


def state_legend(st, states, width, legend_texts=None):
    texts = dict(STATE_TEXT, **(legend_texts or {}))
    shown = [s for s in ("unprotected", "restorable", "downloading", "missing", "absent")
             if s in states.values()]
    if not shown:
        return []
    column = INDENT + st.lw
    chunks = [[(st.g(STATE_GLYPH[s][0]) + " ", STATE_GLYPH[s][1]), (st.t(texts[s]), "dim")] for s in shown]
    return flow([(" " * column, "")], chunks, width, column, ellipsis=st.g("ellipsis"))


def video_rows(st, states, width, pinned_bytes=None, legend_texts=None):
    chunks = []
    for period in PERIODS:
        if period in states:
            glyph, style = STATE_GLYPH[states[period]]
            chunks.append([(st.t(PERIOD_NAMES[period]) + " ", ""), (st.g(glyph), style)])
    if pinned_bytes is not None:
        text = st.t("已保护 {size}", size=human_bytes(pinned_bytes)) if pinned_bytes else st.t("未保护")
        chunks.append([(" " + text, "dim")])
    rows = flow(label_prefix(st, "视频"), chunks, width, INDENT + st.lw, ellipsis=st.g("ellipsis"))
    return rows + state_legend(st, states, width, legend_texts)


def now_next_rows(st, snap, cfg, now, width, applied=None, precise=False):
    series = SERIES.get(snap.get("series"), {})
    period = snap.get("period")
    current_name = series.get(period, ("", "—"))[1]
    when = parse_when(snap.get("nextSwitch"))
    next_period = current_period(when, cfg) if when else None
    next_name = series.get(next_period, ("", ""))[1] if next_period else ""
    name_width = max(dwidth(current_name), dwidth(next_name))
    if applied is None:
        applied = (snap.get("plist") or {}).get("allMatch")
    status = ([(st.g("ok") + " " + st.t("已应用"), "ok")] if applied
              else [(st.g("unpinned") + " " + st.t("待切换"), "warn")])
    period_width = max(dwidth(st.t(name)) for name in PERIOD_NAMES.values())
    main = [(pad(st.t(PERIOD_NAMES.get(period, period or "?")), period_width) + "  ", period or ""),
            (pad(current_name, name_width), "strong")]
    rows = info_row(st, "当前", main, status, width)
    if when:
        seconds = (when - now).total_seconds()
        main = [(pad(st.t(PERIOD_NAMES[next_period]), period_width) + "  ", next_period),
                (pad(next_name, name_width), "")]
        tail = [(when_text(st, when, now), ""),
                (st.t("（{c}）", c=countdown_text(st, seconds, precise)), "dim")]
    else:
        main, tail = [("—", "dim")], [(st.t("极昼或极夜期间不切换"), "dim")]
    return rows + info_row(st, "下一张", main, tail, width)


def agent_rows(st, loaded_now, width):
