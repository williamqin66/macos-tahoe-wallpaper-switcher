DOCTOR_NAMES = (("python", "Python"), ("config", "配置"), ("manifest", "素材清单"),
                ("plist", "壁纸设置"), ("selectedVideos", "当前系列视频"),
                ("cache", "视频缓存"), ("launchAgent", "定时任务"))


def doctor_detail(st, key, check):
    if not check.get("ok"):
        return "fail", str(check.get("error", ""))
    detail = check.get("detail")
    dot = f" {st.g('dot')} "
    if key == "python":
        return "ok", str(detail)
    if key == "config":
        return "ok", SERIES.get(detail.get("series"), {}).get("name", "?") + dot + coords_text(st, detail)
    if key == "manifest":
        problems = [st.t("{name} 缺少 {n} 个", name=i.get("name"), n=len(i["missing"]))
                    for i in detail.values() if i.get("missing")]
        if problems:
            return "warn", "；".join(problems) if not st.english else "; ".join(problems)
        text = st.t("{names} 均已找到", names=st.join(i.get("name", "?") for i in detail.values()))
        pending = [st.t("{name} {n} 个未下载", name=i.get("name"), n=len(i["notDownloaded"]))
                   for i in detail.values() if i.get("notDownloaded")]
        return "ok", text + (st.t("（{c}）", c=st.join(pending)) if pending else "")
    if key == "plist":
        return "ok", st.t("桌面 {d} · 待机 {i}", d=detail.get("desktopCount"), i=detail.get("idleCount"))
    if key == "selectedVideos":
        pending = detail.get("notDownloaded") or []
        if pending:
            return "warn", st.t("{n} 个未下载（{names}），应用时会自动恢复或下载",
                                n=len(pending), names=", ".join(pending))
        return "ok", st.t("{n} 个视频均已下载", n=len(detail.get("ids") or {}))
    if key == "cache":
        states = video_states({"videos": detail.get("videos"), "downloadInProgress": detail.get("downloadInProgress")})
        protected = sum(s == "protected" for s in states.values())
        parts = [st.t("{a}/{b} 已保护", a=protected, b=len(states)), human_bytes(detail.get("pinnedBytes"))]
        if detail.get("downloadInProgress"):
            parts.append(st.t("正在下载"))
        proxy = detail.get("proxy") or {}
        parts.append(st.t("系统代理 {s}", s=st.join(proxy.get("schemes") or [])) if proxy.get("detected")
                     else st.t("无系统代理"))
        return ("ok" if protected == len(states) else "warn"), dot.join(parts)
    if key == "launchAgent":
        text = st.t("运行中") if detail.get("loaded") else st.t("未运行 · 运行 aerial-switch install 启用")
        if detail.get("legacyAgents"):
            return "warn", text + dot + st.t("发现旧版任务，运行 install --migrate 迁移")
        return ("ok" if detail.get("loaded") else "warn"), text
    return "ok", json.dumps(detail, ensure_ascii=False)[:200]


def doctor_body(st, checks, width):
    names = dict(DOCTOR_NAMES)
    keys = [k for k, _ in DOCTOR_NAMES if k in checks] + [k for k in checks if k not in names]
    name_width = max(dwidth(st.t(names.get(k, k))) for k in keys) + 2 if keys else 2
    column = INDENT + 2 + name_width
    body, counts = [], {"ok": 0, "warn": 0, "fail": 0}
    for key in keys:
        level, text = doctor_detail(st, key, checks[key])
        counts[level] += 1
        glyph, style = {"ok": ("ok", "ok"), "warn": ("warn", "warn"), "fail": ("fail", "err")}[level]
        prefix = [(" " * INDENT, ""), (st.g(glyph) + " ", style), (pad(st.t(names.get(key, key)), name_width), "")]
        for index, part in enumerate(wrap_text(text, max(8, width - column))):
            head = prefix if index == 0 else [(" " * column, "")]
            body.append(clip_line(head + [(part, "err" if level == "fail" else "dim" if level == "ok" else "")],
                                  width, st.g("ellipsis")))
    body.append([])
    summary = []
    if counts["fail"]:
        summary.append((st.t("{n} 项失败", n=counts["fail"]), "err"))
    if counts["warn"]:
        summary.append((st.t("{n} 项需要注意", n=counts["warn"]), "warn"))
    if not summary:
        summary.append((st.g("ok") + " " + st.t("全部正常"), "ok"))
    line = [(" " * INDENT, "")]
    for index, item in enumerate(summary):
        line += ([(f" {st.g('dot')} ", "dim")] if index else []) + [item]
    body.append(line)
    return body


def doctor_lines(st, checks, width):
    return page(st, [(st.t("自检"), "")], doctor_body(st, checks, width), width)


def render_ansi(st, lines):
    out = []
    for line in lines:
        text = ""
        for chunk, style in line:
            code = st.ansi(style) if st.color and chunk.strip() else ""
            text += f"\033[{code}m{chunk}\033[0m" if code else chunk
        out.append(text.rstrip())
    return "\n".join(out) + "\n"


def write_text(text, stream):
    try:
        stream.write(text)
    except UnicodeEncodeError:
        encoding = getattr(stream, "encoding", None) or "ascii"
        stream.write(text.encode(encoding, "replace").decode(encoding))
    stream.flush()


def terminal_width():
    return max(20, shutil.get_terminal_size((80, 24)).columns)


def show(view, stream=None):
    stream = stream or sys.stdout
    st = Style.for_stream(stream)
    lines = view(st, terminal_width(), dt.datetime.now().astimezone())
    write_text(render_ansi(st, lines), stream)


