class Dashboard:
    def __init__(self, backend, style, clock=None):
        self.backend, self.st = backend, style
        self.clock = clock or (lambda: dt.datetime.now().astimezone())
        # tui_loop sets background: writes then run on a daemon thread while
        # the screen keeps refreshing.  Direct callers (tests) run them inline.
        self.background = False
        self.task = None  # the running write: label, start time, outcome
        self.quit_armed = self.exit_waiting = False
        self.busy_note = None  # (text, shown until)
        self.editor_visible = True
        self.mode, self.message = "main", None
        self.cfg = self.snap = None
        self.catalog, self.load_errors = {}, []
        self.loaded_at = None
        self.cursor = 0
        self.fields, self.field = {}, 0
        self.draft, self.draft_row = {}, 0
        self.doctor_result = None
        self._schedule_cache = (None, None)
        self.reload(initial=True)

    # -- data -------------------------------------------------------------
    def reload(self, initial=False):
        st = self.st
        self.loaded_at = self.clock()
        self.load_errors = []
        try:
            self.cfg = self.backend.config()
        except Exception as error:  # show any read failure inside the UI
            self.cfg = self.snap = None
            self.load_errors.append(st.t("读取配置失败：{0}").format(error_text(error)))
            return
        try:
            self.catalog = self.backend.catalog()
        except Exception as error:
            self.catalog = {}
            self.load_errors.append(st.t("读取素材清单失败：{0}").format(error_text(error)))
        try:
            self.snap = self.backend.snapshot(self.cfg)
        except Exception as error:
            self.snap = None
            if not any(error_text(error) in item for item in self.load_errors):
                self.load_errors.append(st.t("读取状态失败：{0}").format(error_text(error)))
        if initial and self.cfg.get("series") in SERIES_ORDER:
            self.cursor = SERIES_ORDER.index(self.cfg["series"])

    def needs_reload(self, now):
        if self.task is not None:
            return False  # reloaded when the running write finishes
        if self.loaded_at is None or (now - self.loaded_at).total_seconds() >= RELOAD_SECONDS:
            return True
        when = parse_when(self.snap.get("nextSwitch")) if self.snap else None
        return bool(when and self.loaded_at < when <= now)

    def schedule(self, now, cfg):
        key = (now.date(), cfg["lat"], cfg["lon"]) + tuple(cfg[k] for k, _, _ in DURATION_FIELDS)
        if self._schedule_cache[0] != key:
            self._schedule_cache = (key, day_schedule(now, cfg))
        return self._schedule_cache[1]

    # -- writes -------------------------------------------------------------
    def perform(self, label, operation, done=None, name="操作", refresh=True):
        """Run a write.  Reload status afterwards (when refresh), then call
        done(result) on success or show the error on failure.  In background mode the operation runs on a
        daemon thread and poll() finishes it on the UI thread."""
        if self.task is not None:
            self.note_busy()
            return False
        task = {"label": label, "name": name, "done": done, "refresh": refresh,
                "started": self.clock(), "outcome": None}

        def run():
            try:
                outcome = (True, operation())
            except Exception as error:  # write errors must never leave the UI
                outcome = (False, error)
            task["outcome"] = outcome  # a single assignment hands the result over

        self.task, self.message, self.quit_armed, self.busy_note = task, None, False, None
        if not self.background:
            run()
            self.poll()
            return True
        threading.Thread(target=run, name="aerial-switch-write", daemon=True).start()
        return True

    def poll(self):
        """Finish a completed background write; True when one finished."""
        task = self.task
        if task is None or task["outcome"] is None:
            return False
        self.task, self.quit_armed, self.busy_note = None, False, None
        ok, value = task["outcome"]
        if task["refresh"]:
            self.reload()  # writes may change pins, videos or settings even when they fail
        if ok:
            if task["done"] is not None:
                task["done"](value)
        else:
            self.message = (self.st.g("fail") + " " + self.st.t("操作失败：{0}").format(error_text(value)), "err")
        return True

    def note_busy(self):
        self.busy_note = (self.st.t("{name}进行中，完成后再操作", name=self.st.t(self.task["name"])),
                          self.clock() + dt.timedelta(seconds=3))

    # -- keys ---------------------------------------------------------------
    def handle_key(self, key):
        """Handle one normalised key; return False to quit."""
        if key in (None, "RESIZE") or self.exit_waiting:
            return True
        if self.task is not None:
            return self._key_busy(key)
        if self.mode in ("location", "durations") and not self.editor_visible and key != "ESC":
            # Never edit or save fields the user cannot see.
            self.message = (self.st.t("窗口太小，编辑框未显示：请放大窗口，或按 Esc 取消"), "warn")
            return True
        return getattr(self, "_key_" + self.mode)(key)

    def _key_busy(self, key):
        """Keys while a write runs: browsing works, writes wait, Q twice quits."""
        if key in ("q", "Q") or (key == "ESC" and self.mode != "help"):
            if self.quit_armed:
                return False
            self.quit_armed = True
            return True
        self.quit_armed = False
        if self.mode == "help" and key in ("ESC", "ENTER", "?", "BACKSPACE"):
            self.mode = "main"
        elif self.mode == "main" and key in ("LEFT", "BTAB", "UP", "RIGHT", "TAB", "DOWN"):
            step = -1 if key in ("LEFT", "BTAB", "UP") else 1
            self.cursor = (self.cursor + step) % len(SERIES_ORDER)
        elif self.mode == "main" and key == "?":
            self.mode = "help"
        else:
            self.note_busy()
        return True

    def _key_main(self, key):
        st = self.st
        self.message = None
        if key in ("q", "Q", "ESC"):
            return False
        if key in ("LEFT", "BTAB", "UP"):
            self.cursor = (self.cursor - 1) % len(SERIES_ORDER)
        elif key in ("RIGHT", "TAB", "DOWN"):
            self.cursor = (self.cursor + 1) % len(SERIES_ORDER)
        elif key == "ENTER":
            self.switch_series()
        elif key in ("a", "A"):
            if self.snap is None:
                self.message = (st.t("状态读取失败，无法应用；按 D 查看自检"), "err")
            else:
                self.mode = "confirm"
        elif key in ("l", "L", "t", "T"):
            if self.cfg is None:
                self.message = (st.t("配置读取失败，按 R 重试"), "err")
            elif key in ("l", "L"):
                self.fields = {"lat": number_text(self.cfg["lat"]), "lon": number_text(self.cfg["lon"]),
                               "city": self.cfg.get("city", "")}
                self.field, self.mode = 0, "location"
            else:
                self.draft = {k: float(self.cfg[k]) for k, _, _ in DURATION_FIELDS}
                self.draft_row, self.mode = 0, "durations"
        elif key in ("d", "D"):
            self.run_doctor()
        elif key == "?":
            self.mode = "help"
        elif key in ("r", "R"):
            self.reload()
            self.message = (st.t("已刷新"), "dim")
        return True

    def switch_series(self):
        st = self.st
        key = SERIES_ORDER[self.cursor]
        name = SERIES[key]["name"]
        if self.cfg and self.cfg.get("series") == key:
            self.message = (st.t("{name} 已是当前系列", name=name), "dim")
            return

        def done(result):
            text = st.g("ok") + " " + st.t("已切换到 {name} · 下次检查时生效，或按 A 立即应用", name=name)
            pending = result.get("notDownloaded") or []
            if pending:
                text += st.t("（{n} 个视频待下载）", n=len(pending))
            warnings = (result.get("protection") or {}).get("warnings") or []
            if warnings:
                self.message = (text + f" {st.g('dot')} " + warning_text(st, warnings[0]), "warn")
            else:
                self.message = (text, "ok")

        self.perform(st.t("正在切换到 {name}…", name=name), lambda: self.backend.set_series(key), done,
                     "切换系列")

    def _key_confirm(self, key):
        st = self.st
        if key in ("y", "Y", "ENTER"):
            self.mode = "main"
            self.perform(st.t("正在应用…（如需下载视频可能要等一会儿）"), self.backend.apply,
                         lambda result: setattr(self, "message", self.apply_message(result)), "应用")
        elif key in ("n", "N", "ESC", "q", "Q"):
            self.mode, self.message = "main", (st.t("已取消"), "dim")
        return True

    def apply_message(self, result):
        st = self.st
        warnings = [warning_text(st, w) for w in result.get("warnings") or []
                    if not w.startswith("Current video unavailable")]
        if result.get("downloadError"):
            text = (st.g("fail") + " " + st.t("未切换：视频下载失败，保持原壁纸") + f" {st.g('dot')} "
                    + download_error_text(st, result["downloadError"]))
            return text, "err"
        series = SERIES.get(result.get("series"), {})
        name = series.get(result.get("period"), ("", ""))[1]
        text = st.g("ok") + " " + (st.t("已应用 {name}", name=name) if result.get("updated")
                                   else st.t("壁纸已是最新，无需切换"))
        if warnings:
            return text + f" {st.g('dot')} " + warnings[0], "warn"
        return text, "ok"

    def _key_location(self, key):
        st = self.st
        name = LOCATION_FIELDS[self.field][0]
        if key == "ESC":
            self.mode, self.message = "main", (st.t("已取消，位置未修改"), "dim")
        elif key in ("TAB", "DOWN"):
            self.field = (self.field + 1) % len(LOCATION_FIELDS)
        elif key in ("BTAB", "UP"):
            self.field = (self.field - 1) % len(LOCATION_FIELDS)
        elif key == "BACKSPACE":
            self.fields[name] = self.fields[name][:-1]
        elif key == "CLEAR":
            self.fields[name] = ""
        elif key == "ENTER":
            self.save_location()
        elif len(key) == 1 and key.isprintable():
            if name != "city" and key not in "0123456789.-+":
                self.message = (st.t("纬度和经度只能输入数字"), "warn")
            elif dwidth(self.fields[name]) < (40 if name == "city" else 12):
                self.fields[name] += key
                self.message = None
        return True

    def save_location(self):
        st = self.st
        values = {}
        for index, (name, label, _) in enumerate(LOCATION_FIELDS[:2]):
            low, high = (-90, 90) if name == "lat" else (-180, 180)
            try:
                value = float(self.fields[name].strip())
            except ValueError:
                value = None
            if value is None or not math.isfinite(value) or not low <= value <= high:
                self.field = index
                self.message = (st.g("fail") + " " + st.t("{label}需在 {low} 到 {high} 之间",
                                                          label=st.t(label), low=low, high=high), "err")
                return
            values[name] = value
        city = self.fields["city"].strip()

        def done(_):
            self.mode = "main"
            self.message = (st.g("ok") + " " + st.t("位置已保存 · 下次检查时按新位置切换"), "ok")

        self.perform(st.t("正在保存位置…"), lambda: self.backend.set_location(values["lat"], values["lon"], city),
                     done, "保存位置")

    def _key_durations(self, key):
        st = self.st
        name = DURATION_FIELDS[self.draft_row][0]
        if key == "ESC":
            self.mode, self.message = "main", (st.t("已取消，时段未修改"), "dim")
        elif key in ("UP", "BTAB"):
            self.draft_row = (self.draft_row - 1) % len(DURATION_FIELDS)
        elif key in ("DOWN", "TAB"):
            self.draft_row = (self.draft_row + 1) % len(DURATION_FIELDS)
        elif key in ("LEFT", "RIGHT", "-", "+", "="):
            step = -0.5 if key in ("LEFT", "-") else 0.5
            self.draft[name] = min(6.0, max(0.0, round((self.draft[name] + step) * 2) / 2))
        elif key == "ENTER":
            values = dict(self.draft)

            def done(_):
                self.mode = "main"
                self.message = (st.g("ok") + " " + st.t("时段已保存 · 下次检查时生效"), "ok")

            self.perform(st.t("正在保存时段…"), lambda: self.backend.set_durations(values), done, "保存时段")
        return True

    def run_doctor(self):
        def done(result):
            self.doctor_result, self.mode, self.message = result, "doctor", None

        self.perform(self.st.t("正在自检…"), self.backend.doctor, done, "自检", refresh=False)

    def _key_doctor(self, key):
        if key in ("q", "Q"):
            return False
        if key in ("r", "R"):
            self.run_doctor()
        elif key in ("ESC", "ENTER", "BACKSPACE", "d", "D"):
            self.mode = "main"
        return True

    def _key_help(self, key):
        if key in ("q", "Q"):
            return False
        if key in ("ESC", "ENTER", "?", "BACKSPACE"):
            self.mode = "main"
        return True

    # -- rendering ------------------------------------------------------------
    def render(self, width, height, now=None):
        now = now or self.clock()
        st = self.st
        if width < MIN_WIDTH or height < MIN_HEIGHT:
            self.editor_visible = False
            return self.render_too_small(width, height)
        self.editor_visible = True
        inner = width - 1  # curses cannot safely write the last column
        footer = [self.message_line(inner, now), [(" ", ""), (st.g("rule") * (inner - 1), "dim")],
                  self.keys_line(inner)]
        if self.mode == "doctor":
            parts, body = [(st.t("自检"), "")], doctor_body(st, self.doctor_result or {}, inner)
        elif self.mode == "help":
            parts, body = [(st.t("帮助"), "")], self.help_body(inner)
        else:
            parts = series_title(self.cfg) if self.cfg else []
            body = self.main_body(inner, now, height - 2 - len(footer))
        top = header_lines(st, parts, inner, inner - 1, right=now.strftime("%H:%M:%S"))
        if len(body) + len(top) + 2 + len(footer) <= height:
            top = [[]] + top + [[]]  # breathing room above and below the title when it fits
        room = height - len(top) - len(footer)
        if len(body) > room:
            body = body[:room - 1] + [[(" " * INDENT, ""), (
                st.g("ellipsis") + " " + st.t("窗口高度不足，部分内容未显示"), "dim")]]
        body = body + [[] for _ in range(room - len(body))]
        return [clip_line(line, inner, st.g("ellipsis")) for line in top + body + footer]

    def render_too_small(self, width, height):
        st = self.st
        texts = [(st.t("终端窗口太小"), "strong"),
                 (st.t("当前 {w}{x}{h}，至少需要 {mw}{x}{mh}", w=width, h=height, mw=MIN_WIDTH,
                       mh=MIN_HEIGHT, x=st.g("times")), "dim"),
                 (st.t("按 Esc 取消编辑" if self.mode in ("location", "durations") else "按 Q 退出"), "dim")]
        lines = [[] for _ in range(max(0, height))]
        top = max(0, (height - len(texts)) // 2)
        for offset, (text, style) in enumerate(texts):
            if top + offset < height:
                text = clip(text, max(0, width - 1))
                left = max(0, (width - 1 - dwidth(text)) // 2)
                lines[top + offset] = [(" " * left, ""), (text, style)]
        return lines

    def main_body(self, width, now, room=None):
        """Main page body.  While editing, blocks are dropped (least useful
        first) until the editor fits in ``room`` lines, so the focused field
        is never pushed off screen."""
        st = self.st
        if self.cfg is None:
            return warning_lines(st, self.load_errors, width, "err")
        editing = self.mode in ("location", "durations")
        cfg = dict(self.cfg, **self.draft) if self.mode == "durations" else self.cfg
        blocks = [("timeline", timeline_lines(st, self.schedule(now, cfg), now, width,
                                              bar_width_for(width, 72)) + [[]])]
        if self.snap:
            blocks.append(("now", now_next_rows(st, self.snap, self.cfg, now, width, precise=True) + [[]]))
            blocks.append(("videos", video_rows(st, video_states(self.snap), width, self.snap.get("pinnedBytes"))))
            blocks.append(("agent", agent_rows(st, self.snap.get("launchAgentLoaded"), width)))
        blocks.append(("location", self.location_rows(width)))
        blocks.append(("durations", self.duration_rows(width)))
        if not editing:
            blocks.append(("series", [[]] + self.series_rows(width)))
        warnings = self.load_errors + status_warnings(st, self.snap)
        if warnings:
            blocks.append(("warnings", [[]] + warning_lines(st, warnings, width,
                                                            "err" if self.load_errors else "warn")))
        if editing and room is not None:
            other = "durations" if self.mode == "location" else "location"
            # The durations editor keeps the timeline longest: it previews the edit.
            order = ["warnings", "agent", "videos", "now", other, "timeline"]
            if self.mode == "location":
                order = ["warnings", "agent", "videos", "timeline", "now", other]
            for name in order:
                if sum(len(lines) for _, lines in blocks) <= room:
                    break
                blocks = [(key, lines) for key, lines in blocks if key != name]
            self.editor_visible = sum(len(lines) for _, lines in blocks) <= room
        return [line for _, lines in blocks for line in lines]

    def editor_rows(self, label, rows, width):
        st = self.st
        column = INDENT + st.lw
        lines = []
        for index, (active, spans) in enumerate(rows):
            head = label_prefix(st, label, "accent") if index == 0 else [(" " * column, "")]
            pointer = (st.g("pointer") + " ", "accent") if active else ("  ", "")
            lines.append(clip_line(head + [pointer] + spans, width, st.g("ellipsis")))
        return lines

    def location_rows(self, width):
        st = self.st
        if self.mode != "location":
            return text_rows(st, "位置", coords_text(st, self.cfg), width)
        rows = []
        for index, (name, label, hint) in enumerate(LOCATION_FIELDS):
            active = index == self.field
            size = 14
            if name == "city":  # narrow windows: shrink the box so its hint still fits
                size = max(14, min(22, width - INDENT - st.lw - 2 - 6 - 2 - dwidth(st.t(hint))))
            value = self.fields.get(name, "") + (st.g("caret") if active else "")
            while dwidth(value) > size - 1:
                value = value[1:]
            rows.append((active, [(pad(st.t(label), 6), "strong" if active else "label"),
                                  (pad(" " + value, size), "field_active" if active else "field"),
                                  ("  " + st.t(hint), "dim")]))
        return self.editor_rows("位置", rows, width)

    def duration_rows(self, width):
        st = self.st
        if self.mode != "durations":
            return text_rows(st, "时段", durations_text(st, self.cfg), width)
        rows = []
        for index, (name, label, hint) in enumerate(DURATION_FIELDS):
            active = index == self.draft_row
            value = st.t("{v} 小时", v=f"{self.draft[name]:.1f}")
            shown = (f"{st.g('left')} {value} {st.g('right')}" if active else f"  {value}  ")
            rows.append((active, [(pad(st.t(label), 10), "strong" if active else "label"),
                                  (shown, "accent" if active else ""), ("   " + st.t(hint), "dim")]))
        return self.editor_rows("时段", rows, width)

    def series_rows(self, width):
        st = self.st
        chunks = []
        current = self.cfg.get("series") if self.cfg else None
        for index, key in enumerate(SERIES_ORDER):
            selected = index == self.cursor
            chunks.append([(st.g("pointer") if selected else " ", "accent"),
                           (" " + SERIES[key]["name"] + " ", "sel" if selected else ""),
                           ((st.g("ok") if key == current else " "), "ok")])
        rows = flow(label_prefix(st, "系列"), chunks, width, INDENT + st.lw, sep="   ",
                    ellipsis=st.g("ellipsis"))
        hint = self.series_hint()
        if hint:
            rows += text_rows(st, "", hint, width, "dim")
        return rows

    def series_hint(self):
        st = self.st
        key = SERIES_ORDER[self.cursor]
        name = SERIES[key]["name"]
        info = self.catalog.get(key) or {}
        missing, pending = info.get("missing") or [], info.get("notDownloaded") or []
        if missing:
            return st.t("{name} 在素材清单中缺少 {n} 个视频，无法选择", name=name, n=len(missing))
        if self.cfg and key == self.cfg.get("series"):
            text = st.t("当前系列")
        else:
            text = st.t("Enter 切换到 {name}", name=name)
        if not info:
            return text
        if pending:
            return text + st.t(" · {n} 个视频待下载" if key == (self.cfg or {}).get("series")
                               else " · {n} 个视频待下载，应用时自动下载", n=len(pending))
        return text + st.t(" · 视频均已就绪")

    def busy_line(self, width, now):
        st = self.st
        task = self.task
        seconds = max(0, int((now - task["started"]).total_seconds()))
        frames = st.g("spinner")
        spin = frames[int((now - task["started"]).total_seconds() * 4) % len(frames)]
        if self.exit_waiting:
            text, style = st.t("正在写入壁纸设置，完成后自动退出…"), "warn"
        elif self.quit_armed:
            text, style = st.t("{name}进行中 · 再按一次 Q 强制退出（下载下次续传）",
                               name=st.t(task["name"])), "warn"
        elif self.busy_note and now < self.busy_note[1]:
            text, style = self.busy_note[0], "warn"
        else:
            text, style = task["label"], "accent"
        elapsed = "  " + st.t("{s} 秒", s=seconds)
        # Clip the text, not the timer, so narrow windows still show progress.
        text = clip(text, max(1, width - INDENT - 2 - dwidth(elapsed)), st.g("ellipsis"))
        return clip_line([(" " * INDENT, ""), (spin + " ", "accent"), (text, style), (elapsed, "dim")],
                         width, st.g("ellipsis"))

    def message_line(self, width, now=None):
        st = self.st
        if self.task is not None:
            return self.busy_line(width, now or self.clock())
        if self.mode == "confirm" and self.snap:
            series = SERIES.get(self.snap.get("series"), {})
            period = self.snap.get("period")
            prompt = st.t("立即应用 {p} · {name}？", p=st.t(PERIOD_NAMES.get(period, "")),
                          name=series.get(period, ("", ""))[1])
            return clip_line([(" " * INDENT, ""), (prompt, "strong"), ("   " + st.t("Y 确认   N 取消"), "dim")],
                             width, st.g("ellipsis"))
        if not self.message:
            return []
        text, style = self.message
        return clip_line([(" " * INDENT, ""), (text, style)], width, st.g("ellipsis"))

    def keys_line(self, width):
        st = self.st
        line, used = [(" " * INDENT, "")], INDENT
        keys = FOOTER_KEYS[self.mode]
        if self.task is not None:  # only browsing works while a write runs
            keys = FOOTER_KEYS["busy"] if self.mode in ("main", "help") else (("Q", "退出"),)
        for index, (key, text) in enumerate(keys):
            key = st.g(key) if key in ("lr", "ud") else key
            item = ([("   ", "")] if index else []) + [(key, "key"), (" " + st.t(text), "dim")]
            if used + line_width(item) > width:
                break
            line += item
            used += line_width(item)
        return line

    def help_body(self, width):
        st = self.st
        body = [[(" " * INDENT, ""), (st.t("按键"), "label")]]
        for key, text in HELP_KEYS:
            key = key.replace("lr", st.g("lr"))
            body += flow([(" " * INDENT, ""), (pad(key, 12), "key")], [[(st.t(text), "")]], width,
                         INDENT + 12, ellipsis=st.g("ellipsis"))
        body += [[], [(" " * INDENT, ""), (st.t("说明"), "label")]]
        for note in HELP_NOTES:
            body += [[(" " * INDENT, ""), (part, "dim")] for part in wrap_text(st.t(note), width - INDENT)]
        return body


def curses_attributes(curses, st):
    flags = {"bold": curses.A_BOLD, "dim": curses.A_DIM, "reverse": curses.A_REVERSE,
             "underline": curses.A_UNDERLINE}
    use_color = st.color and curses.has_colors()
    palette, background = 8, -1
    if use_color:
        curses.start_color()
        try:
            curses.use_default_colors()
        except curses.error:
            background = curses.COLOR_BLACK
        palette = 256 if curses.COLORS >= 256 else 8
    attrs, pair = {}, 0
    for name in sorted(set(ATTRS) | set(COLORS)):
        attr, value = ATTRS.get(name), 0
        index = COLORS[name][0 if palette == 256 else 1] if use_color and name in COLORS else None
        if index is not None:
            pair += 1
            try:
                curses.init_pair(pair, index, background)
                value |= curses.color_pair(pair)
                if attr == "dim" and palette == 256:
                    attr = None
            except curses.error:
                pass
        if attr:
            value |= flags[attr]
        attrs[name] = value
    return attrs


def curses_keymap(curses):
    keymap = {curses.KEY_LEFT: "LEFT", curses.KEY_RIGHT: "RIGHT", curses.KEY_UP: "UP",
              curses.KEY_DOWN: "DOWN", curses.KEY_ENTER: "ENTER", curses.KEY_BACKSPACE: "BACKSPACE",
              curses.KEY_DC: "BACKSPACE", curses.KEY_BTAB: "BTAB", curses.KEY_RESIZE: "RESIZE"}
    keymap.update({"\n": "ENTER", "\r": "ENTER", "\t": "TAB", "\x1b": "ESC", "\x7f": "BACKSPACE",
                   "\b": "BACKSPACE", "\x15": "CLEAR", 10: "ENTER", 13: "ENTER", 9: "TAB", 27: "ESC",
                   127: "BACKSPACE", 8: "BACKSPACE", 21: "CLEAR"})
    return keymap


KEY_NAMES = {"LEFT", "RIGHT", "UP", "DOWN", "ENTER", "BACKSPACE", "BTAB", "RESIZE", "TAB",
             "ESC", "CLEAR"}
ESCAPE_SEQUENCES = {"[A": "UP", "[B": "DOWN", "[C": "RIGHT", "[D": "LEFT", "OA": "UP",
                    "OB": "DOWN", "OC": "RIGHT", "OD": "LEFT", "[Z": "BTAB", "OM": "ENTER",
                    "[3~": "BACKSPACE"}


def decode_escape(rest):
    """Map the characters after a lone ESC; unknown sequences are ignored, not Esc."""
    if not rest:
        return "ESC"
    return ESCAPE_SEQUENCES.get(rest)


def translate_key(raw, keymap):
    if raw is None:
        return None
    if raw in KEY_NAMES:
        return raw
    if raw in keymap:
        return keymap[raw]
    if isinstance(raw, str) and len(raw) == 1 and raw.isprintable():
        return raw
    return None


def paint(screen, lines, attrs, ellipsis="…"):
    screen.erase()
    height, width = screen.getmaxyx()
    for y, line in enumerate(lines[:height]):
        x = 0
        for text, style in clip_line(line, max(0, width - 1), ellipsis):
            if text:
                try:
                    screen.addstr(y, x, text, attrs.get(style, 0))
                except Exception:  # curses.error at the screen edge; keep drawing
                    pass
                x += dwidth(text)
    screen.refresh()


def tui_loop(screen, app, attrs, read_key, keymap, clock=None, guard=None):
    """Paint, read one key (read_key waits at most ~0.2 s) and repeat.

    Writes run on a daemon thread (app.background), so the clock, spinner,
    resizing and keys keep working during slow downloads.  Quitting while a
    write runs needs a second Q; the loop then takes ``guard`` (WRITE_GUARD)
    and keeps it, so the process exits outside any plist/JSON/pin write step
    and the worker cannot begin another.  An interrupted download leaves its
    .part file, which the next run resumes.
    """
    clock = clock or app.clock
    guard = WRITE_GUARD if guard is None else guard
    ellipsis = app.st.g("ellipsis")
    app.background = True
    last = None
    while True:
        finished = app.poll()
        if app.exit_waiting and (finished or guard.acquire(blocking=False)):
            return
        now = clock()
        if app.needs_reload(now):
            app.reload()
        height, width = screen.getmaxyx()
        frame = app.render(width, height, now)
        if frame != last:
            paint(screen, frame, attrs, ellipsis)
            last = frame
        key = translate_key(read_key(), keymap)
        if key == "RESIZE":
            screen.clear()
            last = None
            continue
        if key is not None and not app.handle_key(key):
            if app.task is None or guard.acquire(blocking=False):
                return
            app.exit_waiting = True  # a write step is in progress; leave right after it


def run_tui(paths, backend=None):
    import curses
    import locale
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    os.environ.setdefault("ESCDELAY", "25")
    st = Style.for_encoding(locale.getpreferredencoding(False), tty=True)
    backend = backend or LocalBackend(paths)

    def session(screen):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        if hasattr(curses, "set_escdelay"):
            curses.set_escdelay(25)
        screen.keypad(True)
        screen.timeout(200)
        attrs = curses_attributes(curses, st)
        paint(screen, [[], [(" ", ""), ("Aerial Switch", "title"),
                            (" " + st.g("dot") + " " + st.t("正在读取状态…"), "dim")]], attrs)
        app = Dashboard(backend, st)

        def read_key():
            try:
                raw = screen.get_wch()
            except curses.error:
                return None
            if raw not in ("\x1b", 27):
                return raw
            # ncurses returns a lone ESC for sequences it does not know (for
            # example ESC [ C when the terminal ignores application mode).
            rest = ""
            screen.nodelay(True)
            try:
                while len(rest) < 6:
                    try:
                        char = screen.get_wch()
                    except curses.error:
                        break
                    if not isinstance(char, str):
                        break
                    rest += char
                    if len(rest) > 1 and (char.isalpha() or char == "~"):
                        break
            finally:
                screen.timeout(200)
            return decode_escape(rest)

        tui_loop(screen, app, attrs, read_key, curses_keymap(curses))

    try:
        curses.wrapper(session)  # restores the terminal on exit and on exceptions
    except KeyboardInterrupt:
        wait_for_write_guard()
    return 0


def wait_for_write_guard(guard=None, notify=None):
    """After Ctrl-C, never exit while a write/verify/rollback step holds the guard.

    The daemon worker dies with the process, so keep waiting (repeated Ctrl-C
    included) until the critical section has finished.
    """
    guard = WRITE_GUARD if guard is None else guard
    notify = notify or (lambda message: print(message, file=sys.stderr, flush=True))
    warned = False
    while True:
        try:
            if guard.acquire(timeout=30):
                guard.release()
                return
        except KeyboardInterrupt:
            pass
        if not warned:
            notify("正在完成壁纸设置的写入，完成后自动退出…")
            warned = True


def build_parser():
    parser = argparse.ArgumentParser(
        description="Switch Apple aerial wallpapers by local solar time",
        epilog="Run without a command in a terminal to open the interactive dashboard. "
               "Output is human-readable on a terminal and JSON otherwise or with --json.")
    parser.add_argument("--json", action="store_true", help="Print JSON even on a terminal")
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="Print JSON even on a terminal")
    subs = parser.add_subparsers(dest="command")
    subs.add_parser("status", parents=[common])
    apply_parser = subs.add_parser("apply", parents=[common])
    apply_parser.add_argument("--dry-run", action="store_true")
    apply_parser.add_argument("--strict", action="store_true", help="Compatibility no-op; apply always requires the current video")
    series_parser = subs.add_parser("series", parents=[common])
    series_parser.add_argument("name", nargs="?", choices=tuple(SERIES))
    series_parser.add_argument("--force", action="store_true", help="Compatibility option; missing videos are always allowed")
    location_parser = subs.add_parser("location", parents=[common])
    location_parser.add_argument("lat", type=float)
    location_parser.add_argument("lon", type=float)
    location_parser.add_argument("--city", default="")
    install_parser = subs.add_parser("install", parents=[common])
    install_parser.add_argument("--prefix", help="Installation prefix (executable goes in PREFIX/bin)")
    install_parser.add_argument("--migrate", action="store_true", help="Stop legacy LaunchAgents and move their plists to legacy-backup")
    uninstall_parser = subs.add_parser("uninstall", parents=[common])
    uninstall_parser.add_argument("--restore", action="store_true")
    subs.add_parser("doctor", parents=[common])
    return parser


def current_series(paths):
    try:
        return load_config(paths)["series"]
    except Exception:
        return None


def is_tty(stream):
    try:
        return stream.isatty()
    except (AttributeError, ValueError):
        return False


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    paths = Paths()
    if args.command is None:
        if not args.json and is_tty(sys.stdin) and is_tty(sys.stdout):
            return run_tui(paths)
        parser.print_help()
        return 2
    human = not args.json and is_tty(sys.stdout)
    try:
        if args.command == "doctor":
            result = doctor(paths)
            if human:
                show(lambda st, width, now: doctor_lines(st, result, width))
            else:
                print(json.dumps(result, ensure_ascii=False, indent=2))
            return int(any(not check["ok"] for check in result.values()))
        if args.command == "uninstall":
            result = uninstall(paths, args.restore)
            view = lambda st, width, now: uninstall_lines(st, result, width)
        elif args.command == "install":
            result = install(paths, args.prefix, args.migrate)
            view = lambda st, width, now: install_lines(st, result, width, paths)
        elif args.command == "series" and not args.name:
            result = {key: series_payload(str(paths.manifest), key, str(paths.videos)) for key in SERIES}
            view = lambda st, width, now: series_list_lines(st, result, current_series(paths), width,
                                                            series_videos(paths, result))
        elif args.command == "series":
            result = save_series(paths, args.name)
            view = lambda st, width, now: series_saved_lines(st, result, width)
        elif args.command == "location":
            result = save_location(paths, args.lat, args.lon, args.city)
            view = lambda st, width, now: location_saved_lines(st, result, now, width)
        elif args.command == "apply":
            cfg, result = apply_command(paths, args.dry_run)
            view = lambda st, width, now: apply_lines(st, after_apply(paths, cfg, result, args.dry_run),
                                                      cfg, now, width, args.dry_run)
        else:
            cfg = load_config(paths)
            result = snapshot(paths, cfg)
            view = lambda st, width, now: status_lines(st, result, cfg, now, width)
        if human:
            show(view)
        else:
            print(json.dumps(result, ensure_ascii=False, indent=2))
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError, plistlib.InvalidFileException) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
