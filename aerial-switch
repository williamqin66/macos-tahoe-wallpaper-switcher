AERIAL_PROVIDER = "com.apple.wallpaper.choice.aerials"

# Held around short multi-step writes (plist write + verify/rollback, JSON
# replace, pin relinking).  The dashboard runs writes on a daemon thread; on a
# forced quit it takes this lock and keeps it, so the process never exits
# half-way through such a step and the worker cannot start another one.
WRITE_GUARD = threading.RLock()
TARGET_KINDS = {"Desktop", "Idle"}
PERIODS = ("morning", "day", "evening", "night")

# Each series maps a solar period to Apple's manifest shotID (stable across
# localizations) with the English accessibility label as a fallback.
SERIES = {
    "tahoe": {
        "name": "Tahoe",
        "morning": ("TA_L_001", "Tahoe Morning"),
        "day": ("TA_L_002", "Tahoe Day"),
        "evening": ("TA_D_001", "Tahoe Evening"),
        "night": ("TA_D_002", "Tahoe Night"),
    },
    "goldenGate": {
        "name": "Golden Gate",
        "morning": ("GG_A_SUNSET", "Golden Gate Sunset"),
        "day": ("GG_A_DAY", "Golden Gate Day"),
        "evening": ("GG_A_EVENING", "Golden Gate Evening"),
        "night": ("GG_A_NIGHT", "Golden Gate Night"),
    },
}


def load_plist(path):
    with open(path, "rb") as handle:
        return plistlib.load(handle)


def configuration_asset_id(choice):
    configuration = choice.get("Configuration")
    if not isinstance(configuration, (bytes, bytearray)):
        return None

    try:
        decoded = plistlib.loads(bytes(configuration))
    except (ValueError, TypeError, plistlib.InvalidFileException):
        return None

    if not isinstance(decoded, dict):
        return None
    asset_id = decoded.get("assetID")
    return asset_id if isinstance(asset_id, str) else None


def collect_target_choices(root):
    """Collect Choices owned specifically by Desktop and Idle nodes."""
    results = []
    seen = set()

    def walk(node, path=()):
        if isinstance(node, dict):
            for key, value in node.items():
                key_string = str(key)
                child_path = path + (key_string,)

                if key_string in TARGET_KINDS and isinstance(value, dict):
                    content = value.get("Content")
                    choices = content.get("Choices") if isinstance(content, dict) else None
                    if isinstance(choices, list):
                        for index, choice in enumerate(choices):
                            if isinstance(choice, dict) and id(choice) not in seen:
                                seen.add(id(choice))
                                results.append(
                                    {
                                        "kind": key_string,
                                        "path": ".".join(child_path + ("Content", "Choices", str(index))),
                                        "choice": choice,
                                    }
                                )

                walk(value, child_path)
        elif isinstance(node, list):
            for index, value in enumerate(node):
                walk(value, path + (str(index),))

    walk(root)
    # Recent macOS releases store the active wallpaper in Linked nodes under
    # AllSpacesAndDisplays and SystemDefault instead of per-Desktop/Idle nodes.
    # Fill whichever target kind is absent, preserving all other plist data.
    if isinstance(root, dict):
        has_desktop = any(item["kind"] == "Desktop" for item in results)
        has_idle = any(item["kind"] == "Idle" for item in results)
        fallback_owners = []
        if not has_desktop:
            fallback_owners.append("AllSpacesAndDisplays")
        if not has_idle:
            fallback_owners.append("SystemDefault")
        for owner in fallback_owners:
            owner_node = root.get(owner)
            linked = owner_node.get("Linked") if isinstance(owner_node, dict) else None
            content = linked.get("Content") if isinstance(linked, dict) else None
            choices = content.get("Choices") if isinstance(content, dict) else None
            if isinstance(choices, list):
                for index, choice in enumerate(choices):
                    if isinstance(choice, dict) and id(choice) not in seen:
                        seen.add(id(choice))
                        results.append({
                            "kind": owner,
                            "path": f"{owner}.Linked.Content.Choices.{index}",
                            "choice": choice,
                        })
    return results


def status_payload(plist_path, desired_asset_id):
    data = load_plist(plist_path)
    targets = collect_target_choices(data)
    choices = [
        {
            "kind": target["kind"],
            "path": target["path"],
            "provider": target["choice"].get("Provider"),
            "assetID": configuration_asset_id(target["choice"]),
        }
        for target in targets
    ]
    desktop_count = sum(choice["kind"] in ("Desktop", "AllSpacesAndDisplays") for choice in choices)
    idle_count = sum(choice["kind"] in ("Idle", "SystemDefault") for choice in choices)
    all_match = (
        desktop_count > 0
        and idle_count > 0
        and all(choice["assetID"] == desired_asset_id and choice["provider"] == AERIAL_PROVIDER for choice in choices)
    )
    return {
        "allMatch": all_match,
        "desktopCount": desktop_count,
        "idleCount": idle_count,
        "choices": choices,
    }


def fsync_file(path):
    with open(path, "rb") as handle:
        os.fsync(handle.fileno())


def atomic_copy(source, destination):
    destination_directory = os.path.dirname(destination)
    os.makedirs(destination_directory, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(
        prefix=os.path.basename(destination) + ".",
        suffix=".tmp",
        dir=destination_directory,
    )
    os.close(descriptor)
    try:
        shutil.copy2(source, temporary)
        fsync_file(temporary)
        os.replace(temporary, destination)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def atomic_write_plist(path, data):
    output = plistlib.dumps(data, fmt=plistlib.FMT_BINARY)
    plistlib.loads(output)

    directory = os.path.dirname(path)
    descriptor, temporary = tempfile.mkstemp(
        prefix=os.path.basename(path) + ".",
        suffix=".tmp",
        dir=directory,
    )
    try:
        mode = stat.S_IMODE(os.stat(path).st_mode)
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(output)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def apply_asset(plist_path, desired_asset_id, last_good_path):
    lock_path = os.path.join(
        os.path.dirname(plist_path),
        ".tahoe-wallpaper-switcher.lock",
    )

    with open(lock_path, "a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = load_plist(plist_path)
        targets = collect_target_choices(data)
        desktop_count = sum(target["kind"] in ("Desktop", "AllSpacesAndDisplays") for target in targets)
        idle_count = sum(target["kind"] in ("Idle", "SystemDefault") for target in targets)
        if desktop_count == 0 or idle_count == 0:
            raise RuntimeError(
                "Expected at least one Desktop and one Idle Choice; "
                f"found Desktop={desktop_count}, Idle={idle_count}"
            )

        if status_payload(plist_path, desired_asset_id)["allMatch"]:
            return {"updated": 0, "assetID": desired_asset_id}

        configuration = plistlib.dumps(
            {"assetID": desired_asset_id},
            fmt=plistlib.FMT_BINARY,
        )
        for target in targets:
            target["choice"]["Provider"] = AERIAL_PROVIDER
            target["choice"]["Configuration"] = configuration

        with WRITE_GUARD:
            atomic_copy(plist_path, last_good_path)
            replaced = False
            try:
                atomic_write_plist(plist_path, data)
                replaced = True
                verification = status_payload(plist_path, desired_asset_id)
                if not verification["allMatch"]:
                    raise RuntimeError(
                        "Post-write verification failed: "
                        + json.dumps(verification, ensure_ascii=False)
                    )
            except Exception as error:
                if replaced and os.path.isfile(last_good_path):
                    atomic_copy(last_good_path, plist_path)
                    raise RuntimeError(
                        f"Update failed and last-good settings were restored: {error}"
                    ) from error
                raise

        return {
            "updated": len(targets),
            "desktopCount": desktop_count,
            "idleCount": idle_count,
            "assetID": desired_asset_id,
            "lastGood": last_good_path,
        }


def video_stat(path):
    """Return a usable stat result for a non-empty regular file, else None."""
    try:
        info = os.stat(path)
    except FileNotFoundError:
        return None
    return info if stat.S_ISREG(info.st_mode) and info.st_size > 0 else None


def video_present(path):
    """One stat call, so a CacheDelete purge mid-check counts as not downloaded."""
    try:
        info = os.stat(path)
    except FileNotFoundError:
        return False
    return stat.S_ISREG(info.st_mode) and info.st_size > 0


def series_payload(manifest_path, series_key, videos_dir):
    if series_key not in SERIES:
        raise ValueError(
            f"Unknown series {series_key!r}; choose one of: {', '.join(SERIES)}"
        )
    with open(manifest_path, "r", encoding="utf-8") as handle:
        manifest = json.load(handle)
    assets = manifest.get("assets") if isinstance(manifest, dict) else None
    if not isinstance(assets, list):
        raise ValueError("Wallpaper manifest has no assets list")

    series = SERIES[series_key]
    ids = {}
    missing = []
    not_downloaded = []
    for period in PERIODS:
        shot_id, label = series[period]
        match = next(
            (a for a in assets if isinstance(a, dict) and a.get("shotID") == shot_id),
            None,
        ) or next(
            (a for a in assets if isinstance(a, dict) and a.get("accessibilityLabel") == label),
            None,
        )
        asset_id = match.get("id") if match else None
        if not isinstance(asset_id, str) or not asset_id:
            missing.append(label)
            continue
        ids[period] = asset_id
        if videos_dir and not video_present(os.path.join(videos_dir, asset_id + ".mov")):
            not_downloaded.append(label)

    return {
        "series": series_key,
        "name": series["name"],
        "ids": ids,
        "missing": missing,
        "notDownloaded": not_downloaded,
    }


DEFAULTS = {
    "series": "tahoe", "city": "", "lat": 37.3349, "lon": -122.0090,
    "morningHoursAfterSunrise": 2.5, "eveningHoursBeforeSunset": 1.5,
    "eveningHoursAfterSunset": 0.5,
}
LABEL = "com.local.aerial-switch"
OLD_LABELS = (
    "com.user.wallpaper-switch-guard",
    "com.user.wallpaper-switch",
    "com.example.tahoe-wallpaper-switcher",
)


class Paths:
    def __init__(self, home=None):
        self.home = Path(home or os.environ.get("AERIAL_SWITCH_HOME") or Path.home())
        self.support = self.home / "Library/Application Support/aerial-switch"
        store = self.home / "Library/Application Support/com.apple.wallpaper"
        self.plist = store / "Store/Index.plist"
        self.manifest = store / "aerials/manifest/entries.json"
        self.videos = store / "aerials/videos"
        self.pinned = self.support / "pinned"
        self.download_lock = self.support / "download.lock"
        self.config = self.support / "config.json"
        self.state = self.support / "state.json"
        self.backup = self.support / "Index.plist.last-good"
        self.legacy = self.home / "Library/Scripts/wallpaper-switch-config.json"
        self.agent = self.home / "Library/LaunchAgents" / (LABEL + ".plist")
        self.log = self.home / "Library/Logs/aerial-switch.log"


def read_json(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def write_json(path, value):
    with WRITE_GUARD:
        _write_json(path, value)


def _write_json(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp = tempfile.mkstemp(dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, ensure_ascii=False, indent=2, allow_nan=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def validate_config(raw):
    if not isinstance(raw, dict):
        raise ValueError("Config must be a JSON object")
    cfg = dict(DEFAULTS, **raw)
    if cfg["series"] not in SERIES:
        raise ValueError("series must be tahoe or goldenGate")
    if not isinstance(cfg["city"], str):
        raise ValueError("city must be a string")
    for key, low, high in [("lat", -90, 90), ("lon", -180, 180)] + [
            (key, 0, 6) for key in DEFAULTS if key.endswith("Sunrise") or key.endswith("Sunset")]:
        value = cfg[key]
        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or not low <= value <= high:
            raise ValueError(f"{key} must be a finite number in [{low}, {high}]")
    return cfg


def load_config(paths, migrate=False):
    source = paths.config if paths.config.exists() else paths.legacy
    cfg = validate_config(read_json(source) if source.exists() else {})
    if migrate and not paths.config.exists():
        # Copy legacy bytes exactly; leave the user's original untouched.
        if source.exists():
            atomic_copy(str(source), str(paths.config))
        else:
            write_json(paths.config, cfg)
    return cfg


def clock(hours):
    total = math.floor(hours * 60 + 0.5) % 1440
    return f"{total // 60:02d}:{total % 60:02d}"


def solar(now, lat, lon):
    # Match the original JS elapsed-day calculation from local January 0,
    # including the local UTC offset at that date.
    january_zero = dt.datetime(now.year - 1, 12, 31).timestamp()
    n = math.floor((now.timestamp() - january_zero) / 86400)
    b = math.radians(360 / 365.0 * (n - 81))
    decl = math.radians(23.45 * math.sin(b))
    lat_r = math.radians(lat)
    cos_ha = ((math.sin(math.radians(-0.8333)) - math.sin(lat_r) * math.sin(decl))
              / (math.cos(lat_r) * math.cos(decl)))
    ha = math.degrees(math.acos(max(-1, min(1, cos_ha)))) / 15
    eot = (9.87 * math.sin(2*b) - 7.53 * math.cos(b) - 1.5 * math.sin(b)) / 60
    tz = now.utcoffset().total_seconds() / 3600
    return 12 - lon / 15 - eot - ha + tz, 12 - lon / 15 - eot + ha + tz, cos_ha


def in_window(h, start, end):
    return end > start and any(start <= x < end for x in (h - 24, h, h + 24))


def period_at(h, sunrise, sunset, cos_ha, cfg):
    morning_end = sunrise + cfg["morningHoursAfterSunrise"]
    evening_start = max(morning_end, sunset - cfg["eveningHoursBeforeSunset"])
    evening_end = sunset + cfg["eveningHoursAfterSunset"]
    if cos_ha >= 1:
        return "night"
    if cos_ha <= -1:
        return "day"
    if in_window(h, sunrise, morning_end):
        return "morning"
    if in_window(h, evening_start, evening_end):
        return "evening"
    if in_window(h, morning_end, evening_start):
        return "day"
    return "night"


def current_period(now, cfg):
    rise, setting, cos_ha = solar(now, cfg["lat"], cfg["lon"])
    return period_at(now.hour + now.minute / 60, rise, setting, cos_ha, cfg)


def next_transition(now, cfg):
    # Minute resolution matches the scheduler's period calculation; recompute
    # solar times on each local date, including across DST and polar seasons.
    previous = current_period(now, cfg)
    base = now.timestamp() - now.second - now.microsecond / 1e6
    for minute in range(1, 370 * 1440):
        candidate = dt.datetime.fromtimestamp(base + minute * 60).astimezone()
        if current_period(candidate, cfg) != previous:
            return candidate.isoformat(timespec="minutes")
    return None


def run_command(args, check=True):
    return subprocess.run(args, check=check, capture_output=True, text=True, timeout=30)


def service_absent(result):
    message = (result.stderr or "") + (result.stdout or "")
    return any(text in message.lower() for text in
               ("could not find service", "no such process"))


def loaded(label):
    result = run_command(["/bin/launchctl", "print", f"gui/{os.getuid()}/{label}"], check=False)
    if result.returncode == 0:
        return True
    if service_absent(result):
        return False
    raise RuntimeError(f"Cannot inspect LaunchAgent {label}: {result.stderr or result.stdout}")


def legacy_agents(paths):
    return [{"label": label, "loaded": is_loaded, "plist": str(plist),
             "plistExists": exists}
            for label in OLD_LABELS
            for plist in [paths.agent.parent / (label + ".plist")]
            for is_loaded, exists in [(loaded(label), plist.exists())]
            if is_loaded or exists]


def legacy_warning(items):
    return {"legacyAgents": items, "warning": "Legacy LaunchAgents found; run install --migrate"} if items else {"legacyAgents": []}


def migrate_legacy(paths, items):
    # OLD_LABELS puts the recovery guard first so it cannot restore the main job.
    for label in OLD_LABELS:
        if not loaded(label):
            continue
        result = run_command(["/bin/launchctl", "bootout", f"gui/{os.getuid()}/{label}"], check=False)
        if result.returncode and not service_absent(result):
            raise RuntimeError(f"Cannot stop legacy LaunchAgent {label}: {result.stderr or result.stdout}")
        if loaded(label):
            raise RuntimeError(f"Legacy LaunchAgent still loaded: {label}")
    backup = None
    files = []
    for label in OLD_LABELS:
        source = paths.agent.parent / (label + ".plist")
        if source.exists():
            if backup is None:
                root = paths.support / "legacy-backup"
                root.mkdir(parents=True, exist_ok=True)
                backup = Path(tempfile.mkdtemp(prefix=dt.datetime.now().strftime("%Y%m%d-%H%M%S-"), dir=str(root)))
            run_command(["/usr/bin/chflags", "nouchg", str(source)])
            destination = backup / source.name
            source.rename(destination)
            files.append({"source": str(source), "backup": str(destination)})
    return {"labels": [item["label"] for item in items], "files": files,
            "backupDirectory": str(backup) if backup else None}


def verify_legacy_stopped():
    remaining = [label for label in OLD_LABELS if loaded(label)]
    if remaining:
        raise RuntimeError("Legacy LaunchAgents still loaded: " + ", ".join(remaining))


def selected_series(paths, cfg, require_downloads=False):
    info = series_payload(str(paths.manifest), cfg["series"], str(paths.videos))
    if info["missing"] or (require_downloads and info["notDownloaded"]):
        raise ValueError("Series unavailable: " + json.dumps(info, ensure_ascii=False))
    return info


def pin_path(paths, series, asset_id):
    if not asset_id or Path(asset_id).name != asset_id or asset_id in (".", ".."):
        raise ValueError("Invalid manifest asset ID")
    return paths.pinned / series / (asset_id + ".mov")


def device(path):
    while not path.exists():
        path = path.parent
    return path.stat().st_dev


def sync_pins(paths, info, dry_run=False):
    actions, warnings = [], []
    if device(paths.pinned) != device(paths.videos):
        return {"actions": [], "warnings": ["Pin protection skipped: pinned and videos are on different devices"]}
    for old in sorted(paths.pinned.iterdir()) if paths.pinned.exists() else []:
        if old.name != info["series"]:
            actions.append({"action": "removePins", "path": str(old)})
            if not dry_run:
                if old.is_dir() and not old.is_symlink():
                    shutil.rmtree(old)
                else:
                    old.unlink()
    for asset_id in info["ids"].values():
        pin = pin_path(paths, info["series"], asset_id)
        video = paths.videos / (asset_id + ".mov")
        video_info, pin_info = video_stat(video), video_stat(pin)
        present, pinned = video_info is not None, pin_info is not None
        same = present and pinned and (video_info.st_dev, video_info.st_ino) == (pin_info.st_dev, pin_info.st_ino)
        action = ("pin" if present and not pinned else "restore" if pinned and not present
                  else "replacePin" if present and pinned and not same else None)
        if not action:
            continue
        actions.append({"action": action, "assetID": asset_id})
        if dry_run:
            continue
        WRITE_GUARD.acquire()
        try:
            pin.parent.mkdir(parents=True, exist_ok=True)
            paths.videos.mkdir(parents=True, exist_ok=True)
            if action == "restore":
                # Replace an empty cache entry as well as an absent one.
                if video.exists():
                    video.unlink()
                os.link(pin, video)
            else:
                fd, temporary = tempfile.mkstemp(prefix=".pin-", dir=str(pin.parent))
                os.close(fd)
                os.unlink(temporary)
                try:
                    os.link(video, temporary)
                    os.replace(temporary, pin)
                finally:
                    if os.path.exists(temporary):
                        os.unlink(temporary)
        except OSError as error:
            warnings.append(f"{action} {asset_id}: {error}")
        finally:
            WRITE_GUARD.release()
    return {"actions": actions, "warnings": warnings}


def download_busy(paths):
    try:
        handle = open(paths.download_lock, "rb")
    except FileNotFoundError:
        return False
    with handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        return False


def video_cache(paths, info):
    videos = {}
    for period, asset_id in info["ids"].items():
        video = paths.videos / (asset_id + ".mov")
        pin = pin_path(paths, info["series"], asset_id)
        video_info, pin_info = video_stat(video), video_stat(pin)
        present, pinned = video_info is not None, pin_info is not None
        videos[period] = {"assetID": asset_id, "present": present, "pinned": pinned,
                           "sameInode": present and pinned
                           and (video_info.st_dev, video_info.st_ino) == (pin_info.st_dev, pin_info.st_ino)}
    return videos


def cache_status(paths, info):
    videos, inodes = video_cache(paths, info), {}
    if paths.pinned.exists():
        for pin in paths.pinned.rglob("*.mov"):
            try:
                info_stat = pin.stat()
                inodes[(info_stat.st_dev, info_stat.st_ino)] = info_stat.st_size
            except FileNotFoundError:
                pass
    # Never include proxy endpoints, bypass lists, usernames or passwords.
    schemes = sorted(key for key in urllib.request.getproxies() if key != "no")
    return {"videos": videos, "pinnedBytes": sum(inodes.values()),
            "downloadInProgress": download_busy(paths),
            "proxy": {"detected": bool(schemes), "schemes": schemes}}


class DownloadBusy(RuntimeError):
    pass


def download_url(paths, asset_id):
    assets = read_json(paths.manifest)["assets"]
    asset = next(item for item in assets if item.get("id") == asset_id)
    preferred = asset.get("url-4K-SDR-240FPS")
    if isinstance(preferred, str) and preferred.endswith(".mov"):
        return preferred
    for key in sorted(asset):
        value = asset[key]
        if key.startswith("url-") and isinstance(value, str) and value.endswith(".mov"):
            return value
    raise ValueError(f"No download URL for {asset_id}")


def download_video(paths, series, asset_id):
    pin_path(paths, series, asset_id)  # validate before constructing any paths
    paths.support.mkdir(parents=True, exist_ok=True)
    with open(paths.download_lock, "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise DownloadBusy("Another run is downloading; keeping current wallpaper") from error
        video = paths.videos / (asset_id + ".mov")
        if video_present(video):
            return {"actions": [], "warnings": []}
        url = download_url(paths, asset_id)
        paths.videos.mkdir(parents=True, exist_ok=True)
        part = paths.videos / ("." + asset_id + ".mov.part")
        meta_path = paths.videos / ("." + asset_id + ".mov.part.json")
        try:
            meta = read_json(meta_path)
        except (OSError, ValueError):
            meta = None
        offset = part.stat().st_size if part.exists() else 0
        etag = meta.get("etag") if isinstance(meta, dict) else None
        # Only resume a part that came from this exact URL with a strong ETag.
        if offset and (not isinstance(meta, dict) or meta.get("url") != url
                       or not isinstance(etag, str) or not etag or etag.startswith("W/")):
            part.unlink(missing_ok=True)
            offset = 0
        if not offset:
            meta_path.unlink(missing_ok=True)
        headers = {"Range": f"bytes={offset}-", "If-Range": etag} if offset else {}
        request = urllib.request.Request(url, headers=headers)
        # urlopen's default ProxyHandler reads macOS system proxies under launchd.
        try:
            response = urllib.request.urlopen(request, timeout=60)
        except urllib.error.HTTPError as error:
            if error.code == 416:
                part.unlink(missing_ok=True)
            raise
        with response:
            length = response.headers.get("Content-Length")
            if length is None or not length.isdigit():
                part.unlink(missing_ok=True)
                raise ValueError("Download has no valid Content-Length")
            length = int(length)
            total = length
            append = response.status == 206
            if append:
                match = re.fullmatch(r"bytes (\d+)-(\d+)/(\d+)", response.headers.get("Content-Range", ""))
                if not match or int(match[1]) != offset or int(match[2]) + 1 != int(match[3]) or int(match[2]) - offset + 1 != length:
                    part.unlink(missing_ok=True)
                    raise ValueError("Invalid download Content-Range")
                total = int(match[3])
                if response.headers.get("ETag") != etag:
                    part.unlink(missing_ok=True)
                    meta_path.unlink(missing_ok=True)
                    raise ValueError("Download changed on server; restarting next run")
            elif response.status != 200:
                raise ValueError(f"Unexpected download status {response.status}")
            else:
                # Fresh body (no resume, or If-Range said the file changed).
                write_json(meta_path, {"url": url, "etag": response.headers.get("ETag", "")})
            try:
                with open(part, "ab" if append else "wb") as output:
                    os.chmod(part, 0o600)
                    while True:
                        chunk = response.read(1024 * 1024)
                        if not chunk:
                            break
                        output.write(chunk)
            except http.client.IncompleteRead as error:
                part.unlink(missing_ok=True)
                raise ValueError("Download length mismatch") from error
            if part.stat().st_size != total or total == 0:
                part.unlink(missing_ok=True)
                meta_path.unlink(missing_ok=True)
                raise ValueError("Download length mismatch")
            run_command(["/usr/bin/xattr", "-w", "SourceURL", url, str(part)])
            run_command(["/usr/bin/xattr", "-w", "LastETag", response.headers.get("ETag", ""), str(part)])
        part.chmod(0o600)
        os.replace(part, video)
        meta_path.unlink(missing_ok=True)
        # Fix 2: report whether the new video is actually protected.
        return sync_pins(paths, {"series": series, "ids": {"download": asset_id}})


def apply_cache(paths, cfg, result, dry_run):
    info = selected_series(paths, cfg)
    sync = sync_pins(paths, info, dry_run)
    result.update(pinActions=sync["actions"], warnings=sync["warnings"], updated=0)
    desired = result["desiredID"]
    video = paths.videos / (desired + ".mov")
    can_restore = any(item.get("assetID") == desired and item["action"] == "restore" for item in sync["actions"])
    result["ready"] = video_present(video) or (dry_run and can_restore)
    result["plannedActions"] = list(sync["actions"])
    if not result["ready"]:
        result["plannedActions"].append({"action": "download", "assetID": desired})
        if not dry_run:
            try:
                pinned = download_video(paths, cfg["series"], desired)
                result["warnings"].extend("Downloaded but not protected: " + w for w in pinned["warnings"])
                result["ready"] = True
            except Exception as error:
                result["warnings"].append(f"Current video unavailable: {type(error).__name__}")
                result["downloadError"] = type(error).__name__ + (": " + str(error) if isinstance(error, (ValueError, DownloadBusy)) else ": download failed; retry next run")
                result["wouldUpdate"] = False
                return
    result["wouldUpdate"] = result["ready"] and not result["plist"]["allMatch"]
    if not result["plist"]["allMatch"]:
        result["plannedActions"].append({"action": "switch", "assetID": desired, "afterVideoReady": True})
    if not dry_run:
        load_config(paths, migrate=True)
        update = apply_asset(str(paths.plist), desired, str(paths.backup))
        if update["updated"]:
            run_command(["/usr/bin/killall", "WallpaperAgent"], check=False)
        state = {key: result[key] for key in ("series", "period", "desiredID")}
        try:
            old_state = read_json(paths.state)
        except (OSError, ValueError):
            old_state = None
        if old_state != state:
            write_json(paths.state, state)
        result["updated"] = update["updated"]
        now = dt.datetime.now().astimezone()
        result["log"] = f'{clock(now.hour + now.minute / 60)} | {cfg["city"]} | {result["period"]} | {result["sunrise"]}↑ {result["sunset"]}↓'
    transition = result["nextSwitch"]
    if transition:
        when = dt.datetime.fromisoformat(transition)
        if 0 <= (when - dt.datetime.now().astimezone()).total_seconds() <= 45 * 60:
            next_id = info["ids"][current_period(when, cfg)]
            next_video = paths.videos / (next_id + ".mov")
            if not video_present(next_video):
                restored = dry_run and any(item.get("assetID") == next_id and item["action"] == "restore" for item in sync["actions"])
                if not restored:
                    result["plannedActions"].append({"action": "prefetch", "assetID": next_id})
                    if not dry_run:
                        try:
                            pinned = download_video(paths, cfg["series"], next_id)
                            result["warnings"].extend("Prefetched but not protected: " + w for w in pinned["warnings"])
                        except Exception as error:
                            result["warnings"].append(f"Prefetch failed: {type(error).__name__}; retry next run")


def snapshot(paths, cfg):
    now = dt.datetime.now().astimezone()
    rise, setting, cos_ha = solar(now, cfg["lat"], cfg["lon"])
    period = current_period(now, cfg)
    info = selected_series(paths, cfg, require_downloads=False)
    desired = info["ids"][period]
    return {"series": cfg["series"], "city": cfg["city"], "period": period,
            "sunrise": clock(rise) if -1 < cos_ha < 1 else None,
            "sunset": clock(setting) if -1 < cos_ha < 1 else None,
            "solarCondition": "polar night" if cos_ha >= 1 else "polar day" if cos_ha <= -1 else "normal",
            "nextSwitch": next_transition(now, cfg), "desiredID": desired,
            "plist": status_payload(str(paths.plist), desired),
            "launchAgentLoaded": loaded(LABEL), "notDownloaded": info["notDownloaded"],
            **legacy_warning(legacy_agents(paths)), **cache_status(paths, info)}


def install(paths, prefix, migrate):
    cfg = load_config(paths)
    selected_series(paths, cfg)
    # Resolve before touching launchd: launchd does not keep the caller's
    # working directory, so ProgramArguments must be absolute.
    destination = (Path(prefix).expanduser().resolve() / "bin/aerial-switch"
                   if prefix else paths.home / ".local/bin/aerial-switch")
    legacy = legacy_agents(paths)
    if legacy and not migrate:
        raise ValueError("Legacy LaunchAgents found; re-run install --migrate: "
                         + json.dumps(legacy, ensure_ascii=False))
    migration = migrate_legacy(paths, legacy) if migrate else None
    verify_legacy_stopped()
    load_config(paths, migrate=True)
    destination.parent.mkdir(parents=True, exist_ok=True)
    if Path(__file__).resolve() != destination.resolve():
        atomic_copy(str(Path(__file__).resolve()), str(destination))
    destination.chmod(0o755)
    paths.agent.parent.mkdir(parents=True, exist_ok=True)
    paths.log.parent.mkdir(parents=True, exist_ok=True)
    agent = {"Label": LABEL, "ProgramArguments": [str(destination), "apply"],
             "RunAtLoad": True, "StartInterval": 900,
             "StandardOutPath": str(paths.log), "StandardErrorPath": str(paths.log)}
    # Preserve an injected home in isolated installations as well.
    if os.environ.get("AERIAL_SWITCH_HOME"):
        agent["EnvironmentVariables"] = {"AERIAL_SWITCH_HOME": str(paths.home)}
    if loaded(LABEL):
        run_command(["/bin/launchctl", "bootout", f"gui/{os.getuid()}/{LABEL}"])
    if not paths.agent.exists():
        paths.agent.touch(mode=0o600)
    atomic_write_plist(str(paths.agent), agent)
    verify_legacy_stopped()
    run_command(["/bin/launchctl", "bootstrap", f"gui/{os.getuid()}", str(paths.agent)])
    return {"installed": str(destination), "launchAgent": str(paths.agent),
            "migration": migration}


def validated_backup_bytes(backup_path):
    """Read the backup once and check it is a usable wallpaper plist."""
    if not backup_path.is_file():
        raise ValueError(f"Backup does not exist: {backup_path}")
    raw = backup_path.read_bytes()
    try:
        data = plistlib.loads(raw)
    except (ValueError, TypeError, plistlib.InvalidFileException) as error:
        raise ValueError(f"Backup is not a valid plist: {error}") from error
    kinds = {target["kind"] for target in collect_target_choices(data)}
    if not kinds.intersection({"Desktop", "AllSpacesAndDisplays"}) or not kinds.intersection({"Idle", "SystemDefault"}):
        raise ValueError("Backup has no Desktop/Idle targets")
    return raw


def atomic_write_bytes(path, raw):
    directory = os.path.dirname(path)
    descriptor, temporary = tempfile.mkstemp(
        prefix=os.path.basename(path) + ".", suffix=".tmp", dir=directory,
    )
    try:
        if os.path.exists(path):
            os.fchmod(descriptor, stat.S_IMODE(os.stat(path).st_mode))
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(raw)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def restore_backup(plist_path, backup_path):
    """Restore one fixed backup snapshot under the apply lock.

    The backup is re-read and validated while holding the lock so a concurrent
    apply cannot swap it between validation and copy. If verification fails,
    the pre-restore plist is put back.
    """
    lock_path = plist_path.parent / ".tahoe-wallpaper-switcher.lock"
    with open(lock_path, "a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        raw = validated_backup_bytes(backup_path)
        before = plist_path.read_bytes()
        atomic_write_bytes(str(plist_path), raw)
        if plist_path.read_bytes() != raw:
            atomic_write_bytes(str(plist_path), before)
            raise RuntimeError("Restore verification failed; previous settings were put back")


def uninstall(paths, restore):
    if restore:
        validated_backup_bytes(paths.backup)  # fail early, before touching launchd
    if loaded(LABEL):
        run_command(["/bin/launchctl", "bootout", f"gui/{os.getuid()}/{LABEL}"])
    if paths.agent.exists():
        paths.agent.unlink()
    if restore:
        restore_backup(paths.plist, paths.backup)
        run_command(["/usr/bin/killall", "WallpaperAgent"], check=False)
    if paths.pinned.exists():
        shutil.rmtree(paths.pinned)
    return {"removedPins": str(paths.pinned), "uninstalled": True, "restored": restore, "kept": "executable, config, state, backup and legacy files"}


def doctor(paths):
    checks = {}
    def check(name, operation):
        try:
            checks[name] = {"ok": True, "detail": operation()}
        except Exception as error:
            checks[name] = {"ok": False, "error": str(error)}
    def python_check():
        if not os.access("/usr/bin/python3", os.X_OK):
            raise ValueError("/usr/bin/python3 is not executable")
        return run_command(["/usr/bin/python3", "--version"]).stdout.strip()
    def plist_check():
        result = status_payload(str(paths.plist), "")
        if not result["desktopCount"] or not result["idleCount"]:
            raise ValueError("No Desktop/Idle targets")
        return result
    check("python", python_check)
    check("config", lambda: load_config(paths))
    check("manifest", lambda: {key: series_payload(str(paths.manifest), key, str(paths.videos)) for key in SERIES})
    check("plist", plist_check)
    check("selectedVideos", lambda: selected_series(paths, load_config(paths)))
    check("cache", lambda: cache_status(paths, selected_series(paths, load_config(paths))))
    check("launchAgent", lambda: {"loaded": loaded(LABEL), **legacy_warning(legacy_agents(paths))})
    if checks["selectedVideos"]["ok"] and checks["selectedVideos"]["detail"]["notDownloaded"]:
        checks["selectedVideos"]["warning"] = "notDownloaded: apply will restore or download the current video before switching"
    return checks


def save_series(paths, name):
    cfg = load_config(paths)
    cfg["series"] = name
    info = selected_series(paths, cfg)
    cfg = validate_config(cfg)
    write_json(paths.config, cfg)
    return dict(cfg, notDownloaded=info["notDownloaded"], protection=sync_pins(paths, info),
                message="Series saved; run apply to switch. No downloads performed.")


def save_config_values(paths, **values):
    cfg = load_config(paths)
    cfg.update(values)
    cfg = validate_config(cfg)
    write_json(paths.config, cfg)
    return cfg


def save_location(paths, lat, lon, city):
    return save_config_values(paths, lat=lat, lon=lon, city=city)


def apply_command(paths, dry_run):
    cfg = load_config(paths)
    result = snapshot(paths, cfg)
    apply_cache(paths, cfg, result, dry_run)
    return cfg, result


def after_apply(paths, cfg, result, dry_run):
    """For display only: a copy of an apply result whose video, pin and plist
    fields are re-read after the run (the result itself, printed as JSON,
    keeps the pre-run snapshot)."""
    if dry_run:
        return result
    shown = dict(result)
    try:
        info = selected_series(paths, cfg)
        shown.update(cache_status(paths, info), notDownloaded=info["notDownloaded"],
                     plist=status_payload(str(paths.plist), result["desiredID"]))
    except Exception:  # keep the pre-run figures rather than fail after a successful apply
        pass
    return shown


def series_videos(paths, payload):
    """Per-series present/pinned/sameInode, as status reports for the current series."""
    videos = {}
    for key, info in payload.items():
        try:
            videos[key] = video_cache(paths, info)
        except (OSError, ValueError):
            pass
    return videos


