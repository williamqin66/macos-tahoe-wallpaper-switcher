def warning_text(st, text, patterns=WARNING_PATTERNS[:-2]):
    for pattern, template in patterns:
        match = re.match(pattern, text)
        if match:
            return st.t(template).format(*match.groups())
    return text


def download_error_text(st, text):
    return warning_text(st, text, WARNING_PATTERNS[-2:])


def status_warnings(st, snap):
    items = []
    legacy = (snap or {}).get("legacyAgents") or []
    if legacy:
        labels = st.join(item.get("label", "?") for item in legacy)
        items.append(st.t("发现旧版定时任务 {labels}；运行 aerial-switch install --migrate 迁移", labels=labels))
    unprotected = [p for p, s in video_states(snap).items() if s == "unprotected"]
    if unprotected:
        names = st.join(st.t(PERIOD_NAMES[p]) for p in unprotected)
        items.append(st.t("{names} 视频尚未受硬链接保护，下次检查时补上", names=names))
    return items


def warning_lines(st, items, width, style="warn"):
    column = INDENT + st.lw
    lines = []
    for index, item in enumerate(items):
        for part_index, part in enumerate(wrap_text(item, max(8, width - column - 2))):
            head = (label_prefix(st, "注意", style) if index == 0 and part_index == 0
                    else [(" " * column, "")])
            mark = [(st.g("warn") + " ", style)] if part_index == 0 else [("  ", "")]
            lines.append(clip_line(head + mark + [(part, "")], width, st.g("ellipsis")))
    return lines


def header_lines(st, parts, width, rule_width, right=None):
    title = [(" ", ""), ("Aerial Switch", "title")]
    for text, style in parts:
        if text:
            title += [(" " + st.g("dot") + " ", "dim"), (text, style)]
    if right:
        gap = width - line_width(title) - dwidth(right) - 1
        if gap >= 2:
            title += [(" " * gap, ""), (right, "dim")]
    rule = [(" ", ""), (st.g("rule") * max(1, min(rule_width, width - 1)), "dim")]
    return [clip_line(title, width, st.g("ellipsis")), rule]


def page(st, parts, body, width):
    rule_width = max([line_width(line) for line in body] + [24]) - 1
    return header_lines(st, parts, width, rule_width) + body


def series_title(snap_or_cfg):
    key = snap_or_cfg.get("series")
    return [(SERIES[key]["name"] if key in SERIES else str(key), "series"),
            (snap_or_cfg.get("city") or "", "")]


def status_lines(st, snap, cfg, now, width, outcome=None, extra_warnings=(), applied=None,
                 suffix=None):
    body = timeline_lines(st, day_schedule(now, cfg), now, width, bar_width_for(width))
    body.append([])
    body += now_next_rows(st, snap, cfg, now, width, applied)
    body.append([])
    body += video_rows(st, video_states(snap), width, snap.get("pinnedBytes"))
    body += agent_rows(st, snap.get("launchAgentLoaded"), width)
    if outcome:
        body.append([])
        body += outcome
    warnings = list(extra_warnings) + status_warnings(st, snap)
    if warnings:
        body.append([])
        body += warning_lines(st, warnings, width)
    parts = series_title(snap) + ([(st.t(suffix), "accent")] if suffix else [])
    return page(st, parts, body, width)


ACTION_TEXT = {"pin": "保护{p}视频", "restore": "恢复{p}视频", "replacePin": "更新{p}视频的保护",
               "download": "下载{p}视频", "prefetch": "预取{p}视频"}


def action_words(st, result):
    periods = {v.get("assetID"): p for p, v in (result.get("videos") or {}).items()}
    words = []
    for action in result.get("plannedActions") or []:
        kind = action.get("action")
        if kind == "removePins":
            words.append(st.t("移除其他系列的保护"))
        elif kind == "switch":
            words.append(st.t("切换壁纸"))
        elif kind in ACTION_TEXT:
            asset = action.get("assetID") or ""
            name = st.t(PERIOD_NAMES[periods[asset]]) if asset in periods else asset[:8]
            words.append(st.t(ACTION_TEXT[kind], p=name))
    return words


def apply_lines(st, result, cfg, now, width, dry_run):
    words = action_words(st, result)
    dot = f" {st.g('dot')} "
    warnings = []
    if result.get("downloadError"):
        warnings.append(download_error_text(st, result["downloadError"]))
    warnings += [warning_text(st, w) for w in result.get("warnings") or []
                 if not (result.get("downloadError") and w.startswith("Current video unavailable"))]
    if dry_run:
        text = st.t("将：{0}").format(dot.join(words)) if words else st.t("无需任何操作")
        outcome = text_rows(st, "预演", text, width)
        return status_lines(st, result, cfg, now, width, outcome, warnings, suffix="预演")
    name = st.t(PERIOD_NAMES.get(result.get("period"), ""))
    if result.get("downloadError"):
        outcome = text_rows(st, "本次", st.g("fail") + " " + st.t("未切换：视频下载失败，保持原壁纸"), width, "err")
    elif result.get("updated"):
        outcome = text_rows(st, "本次", st.g("ok") + " " + st.t("已切换到{p}壁纸", p=name), width, "ok")
    else:
        outcome = text_rows(st, "本次", st.g("ok") + " " + st.t("壁纸已是最新，无需切换"), width, "ok")
    done = [w for w in words if w != st.t("切换壁纸")]
    if done:
        outcome += text_rows(st, "", dot.join(done), width, "dim")
    applied = None if result.get("downloadError") else True
    return status_lines(st, result, cfg, now, width, outcome, warnings, applied)


def series_list_lines(st, payload, current, width, videos=None):
    """Both series with the same per-video symbols as status.  ``videos`` maps
    series -> period -> present/pinned/sameInode (see series_videos); without
    it a downloaded video is shown as not protected rather than guessed."""
    keys = [k for k in SERIES_ORDER if k in payload] + [k for k in payload if k not in SERIES_ORDER]
    names = {key: payload[key].get("name", key) for key in keys}
    name_width = max([dwidth(n) for n in names.values()] + [1])
    body, seen, others_unprotected, current_unprotected = [], {}, False, []
    for key in keys:
        info = payload[key]
        is_current = key == current
        cache = (videos or {}).get(key) or {}
        chunks = []
        for period in PERIODS:
            label = SERIES.get(key, {}).get(period, ("", ""))[1]
            if label in (info.get("missing") or []):
                state = "absent"
            elif isinstance(cache.get(period), dict):
                state = video_state(cache[period])
            else:
                state = "missing" if label in (info.get("notDownloaded") or []) else "unprotected"
            seen[period + key] = state
            glyph, style = STATE_GLYPH[state]
            if state in ("unprotected", "restorable"):
                if is_current:
                    current_unprotected += [period] if state == "unprotected" else []
                else:
                    others_unprotected, style = True, "dim"  # expected: only the selected series is pinned
            chunks.append([(st.t(PERIOD_NAMES[period]) + " ", ""), (st.g(glyph), style)])
        if is_current:
            chunks.append([(" " + st.t("当前"), "dim")])
        prefix = [(" " * INDENT, ""),
                  (st.g("current") if is_current else st.g("other"), "accent" if is_current else "dim"),
                  (" " + pad(names[key], name_width) + "   ", "strong" if is_current else "")]
        body += flow(prefix, chunks, width, line_width(prefix), ellipsis=st.g("ellipsis"))
    body += state_legend(st, seen, width, {"missing": "未下载，应用时自动下载"})
    if others_unprotected:
        column = INDENT + st.lw
        body += [[(" " * column, ""), (part, "dim")]
                 for part in wrap_text(st.t("未选中的系列不受保护，系统可能清理"), max(8, width - column))]
    body.append([])
    body += text_rows(st, "切换", st.t("用 aerial-switch series goldenGate 或 tahoe 选择"), width, "dim")
    if current_unprotected:
        names_text = st.join(st.t(PERIOD_NAMES[p]) for p in current_unprotected)
        body.append([])
        body += warning_lines(st, [st.t("{names} 视频尚未受硬链接保护，下次检查时补上", names=names_text)], width)
    return page(st, [(st.t("系列"), "")], body, width)


def series_saved_lines(st, result, width):
    key = result.get("series")
    name = SERIES.get(key, {}).get("name", key)
    protection = result.get("protection") or {}
    pin_warnings = protection.get("warnings") or []
    body = [[(" " * INDENT, ""), (st.g("ok") + " " + st.t("已选择 {name}", name=name), "ok")]]
    body += [[(" " * (INDENT + 2), ""), (part, "dim")] for part in wrap_text(
        st.t("下次检查时生效（最多 15 分钟），或运行 aerial-switch apply 立即应用"), width - INDENT - 2)]
    body.append([])
    missing = result.get("notDownloaded") or []
    states = {p: ("missing" if SERIES.get(key, {}).get(p, ("", ""))[1] in missing
                  else "unprotected" if pin_warnings else "protected") for p in PERIODS}
    body += video_rows(st, states, width, legend_texts={"missing": "未下载，应用时自动下载"})
    actions = protection.get("actions") or []
    pinned = sum(a.get("action") in ("pin", "replacePin", "restore") for a in actions)
    parts = ([st.t("新增保护 {n} 个视频", n=pinned)] if pinned else []) + (
        [st.t("移除其他系列的保护")] if any(a.get("action") == "removePins" for a in actions) else [])
    body += text_rows(st, "保护", f" {st.g('dot')} ".join(parts) or st.t("无变化"), width)
    if pin_warnings:
        body.append([])
        body += warning_lines(st, [warning_text(st, w) for w in pin_warnings], width)
